{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "miniledger",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miniledger.app"
    },
    "android": {
      "package": "com.miniledger.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B3B2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniLedger needs photo access so you can attach receipt photos to loans.",
          "cameraPermission": "MiniLedger can use your camera to snap a receipt."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2E9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
