# ─────────────────────────────────────────────────────────────
# MiniLedger API — environment variables
# Copy this file to `.env` and adjust the values.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"

# Secret used to sign JWTs and pepper OTP hashes. Use 32+ random chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-16-chars"
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins, or * for all.
# Native apps ignore CORS, so * is fine for assignment/demo use.
CORS_ORIGIN=*

# Optional public base URL used to build absolute receipt URLs.
# Leave empty to return host-relative paths like /uploads/receipt.jpg
PUBLIC_BASE_URL=

# Mock OTP settings (the OTP is printed to the API console)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Receipt uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
